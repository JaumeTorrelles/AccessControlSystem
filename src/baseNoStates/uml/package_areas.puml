@startuml
skinparam classAttributeIconSize 0

package java{
    package baseNoStates{
        package areas{
            abstract class Area {
                + {abstract} getDoorsGivingAccess() : ArrayList<Door>
                + {abstract} getSpaces() : ArrayList<Space>
                + {abstract} findAreaById(id : String) : Area
            }

            class Partition {
                - id : String
                - childAreas : ArrayList<Area>
                + Partition(id : String)
                + addChildArea(child : Area)
                + getDoorsGivingAccess() : ArrayList<Door>
                + getSpaces() : ArrayList<Space>
                + findAreaById(id : String) : Area
            }

            class Space {
                - id : String
                - doors : ArrayList<Door>
                + Space(id : String)
                + addDoor(door : Door)
                + getId() : String
                + getDoorsGivingAccess() : ArrayList<Door>
                + getSpaces() : ArrayList<Space>
                + findAreaById(id : String) : Area
            }

            class DirectoryAreas {
                - {static} rootArea : Area
                - {static} allDoors : Door[]
                + {static} makeAreas()
                + {static} findAreaById(id : String) : Area
                + {static} findDoorById(id : String) : Door
                + {static} getAllDoors() : Door[]
            }
        }
        class Door {
            - id : String
            + getId() : String
            + isClosed() : boolean
        }
    }
}

Area <|-- Partition
Area <|-- Space
Partition --> "*" Area : childAreas
Space --> "*" Door : doors
DirectoryAreas --> "1" Area : rootArea
DirectoryAreas --> "*" Door : allDoors

@enduml
